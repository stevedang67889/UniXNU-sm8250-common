# SM8250 kernel configuration fragment.
# The board defconfig selects the platform; these options are shared by every
# SM8250 device.
CONFIG_ARCH_QCOM=y
CONFIG_ARM64_VA_BITS_39=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_APCS_IPC=y
CONFIG_PINCTRL_SM8250=y
CONFIG_CLK_QCOM_SM8250=y
CONFIG_QCOM_GENI_SE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_QCOM_RPMHPD=y
